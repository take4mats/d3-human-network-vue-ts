{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "公開リポジトリは非公開の github-settings の preset を参照できないため、renovate/base.json の内容を直接記述している。base.json を変えたらここも合わせる。",
  "extends": [
    "config:recommended",
    ":timezone(Asia/Tokyo)"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "ESLint, Prettier and their Vue/TypeScript configs must move together",
      "groupName": "lint tooling",
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-vue",
        "prettier",
        "@vue/eslint-config-prettier",
        "@vue/eslint-config-typescript"
      ]
    },
    {
      "description": "Build toolchain: Vite, its Vue/Vuetify plugins and type checking",
      "groupName": "build tooling",
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-vue",
        "vite-plugin-vuetify",
        "vue-tsc",
        "@vue/tsconfig"
      ]
    }
  ]
}
